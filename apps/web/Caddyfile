# Static hosting for the dashboard. {$VAR} values are read from the environment at start-up:
# VITE_API_BASE and VITE_FIREBASE_AUTH_DOMAIN are the same service variables the build used, so
# the CSP always allows exactly the API and sign-in domain the bundle talks to.
{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Firebase sign-in: the popup helper script (apis.google.com), its iframe on the auth
		# domain, and the identity/token endpoints. Nothing else is loaded from anywhere.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' {$VITE_API_BASE} https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://{$VITE_FIREBASE_AUTH_DOMAIN} https://apis.google.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# same-origin-allow-popups: the Google sign-in popup must be able to report back.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Hashed build output: cache forever, and a missing file is a 404 (never index.html, which
	# a browser would try to run as a script).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: always revalidate so a deploy reaches office TVs.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
