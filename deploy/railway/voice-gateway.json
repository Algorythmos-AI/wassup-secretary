{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "services/voice-gateway/**",
      "libs/**",
      "Dockerfile",
      "pyproject.toml",
      "uv.lock"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 2,
    "drainingSeconds": 35,
    "overlapSeconds": 10
  }
}
