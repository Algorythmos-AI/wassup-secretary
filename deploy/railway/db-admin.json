{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "db/roles.sql",
      "db/grant_database.sql",
      "db/bootstrap.py"
    ]
  },
  "deploy": {
    "startCommand": "python db/bootstrap.py",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
